FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8080

# Applique les migrations Alembic avant de démarrer l'API : la base doit
# toujours être à jour avec les modèles (cf. docs/phase2/13-alembic-migrations.md).
CMD ["sh", "-c", "alembic upgrade head && uvicorn main:app --host 0.0.0.0 --port 8080 --reload"]