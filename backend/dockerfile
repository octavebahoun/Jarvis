FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8080

# Les migrations Alembic sont appliquées par le service dédié "migrate" de
# docker-compose.yml, avant que backend/worker ne démarrent (cf.
# docs/phase2/14-fix-course-migrations-concurrentes.md) : elles ne sont plus
# lancées ici pour éviter que deux containers ne migrent la même base en
# parallèle.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]