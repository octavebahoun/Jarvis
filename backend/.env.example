OPENAI_API_KEY=sk-...

# Chat (LLM) : "openai" (payant, GPT-4o) ou "openrouter" (modèles gratuits
# ":free", ex. meta-llama/llama-3.1-8b-instruct:free). Clé sur openrouter.ai.
CHAT_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8000
SECRET_KEY=change-this-in-production

# Embeddings (mémoire vectorielle) : "openai" (payant, text-embedding-3-small)
# ou "local" (MiniLM embarqué dans ChromaDB, gratuit, tourne sur CPU).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Phase 2 — Tool System : répertoire auquel file_reader (et les futurs tools
# fichiers) sont strictement limités. Jamais d'accès en dehors.
SANDBOX_PATH=./sandbox

# Phase 2 — tool web_search : clé gratuite sur tavily.com (1000 recherches/mois).
TAVILY_API_KEY=

# Phase 2 — tool code_executor : container Docker jetable, réseau désactivé.
# Nécessite un daemon Docker accessible depuis le backend.
CODE_EXECUTOR_IMAGE=python:3.11-slim
CODE_EXECUTOR_TIMEOUT_SECONDS=10
CODE_EXECUTOR_MEMORY_LIMIT=256m
CODE_EXECUTOR_CPU_LIMIT=0.5

# Phase 2 — tool browser_automation (Playwright) : container Docker jetable,
# réseau activé (nécessaire pour atteindre de vrais sites).
BROWSER_AUTOMATION_IMAGE=mcr.microsoft.com/playwright/python:v1.49.0-noble
BROWSER_AUTOMATION_TIMEOUT_SECONDS=30
BROWSER_AUTOMATION_MEMORY_LIMIT=512m
BROWSER_AUTOMATION_CPU_LIMIT=1.0

# Phase 2 — queue Celery : DB Redis dédiées (séparées du court terme, doc 09).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2