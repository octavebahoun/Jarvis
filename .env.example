OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Chat (LLM) : "openai" (payant, GPT-4o) ou "openrouter" (modèles gratuits
# ":free", ex. meta-llama/llama-3.1-8b-instruct:free). Clé sur openrouter.ai.
CHAT_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8000
SECRET_KEY=change-this-in-production

# Embeddings (mémoire vectorielle) : "openai" (payant, text-embedding-3-small)
# ou "local" (MiniLM embarqué dans ChromaDB, gratuit, tourne sur CPU).
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
